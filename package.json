{
  "name": "fund-plan",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "",
  "directories": {
    "doc": "docs"
  },
  "author": "",
  "license": "ISC",
  "keywords": [],
  "main": "index.js",
  "scripts": {
    "dev": "pnpm uno:build && react-router dev",
    "build": "pnpm uno:build && react-router build",
    "start": "wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fund-plan-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply fund-plan-db --remote",
    "cf-typegen": "wrangler types",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:all": "pnpm test && pnpm test:workers",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "uno:build": "unocss \"app/**/*.{ts,tsx}\" -o app/uno.gen.css",
    "uno:watch": "unocss \"app/**/*.{ts,tsx}\" -o app/uno.gen.css --watch"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.2.2",
    "@ant-design/pro-components": "3.1.14-7",
    "@react-router/node": "^8.3.0",
    "antd": "^6.6.1",
    "dayjs": "^1.11.23",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@antfu/eslint-config": "^9.3.0",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@react-router/dev": "^8.3.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@unocss/cli": "^66.8.1",
    "@unocss/reset": "^66.8.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unocss": "^66.8.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm typecheck && pnpm test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css,html}": "eslint --fix"
  }
}
