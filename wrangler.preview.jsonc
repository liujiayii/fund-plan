{
  "$schema": "node_modules/wrangler/config-schema.json",
  // PR 预览环境专用配置——与 wrangler.jsonc 平行，deploy 时用 `-c` 指向本文件：
  //   pnpm exec wrangler deploy -c wrangler.preview.jsonc
  //
  // 隔离策略（2026-09-08 定案）：**共享生产 D1/KV**，只隔离 Worker 实例。
  // 理由：个人测试站，接受测试数据混进生产盘 + KV 写额度（账户级 1000 次/天）
  // 共享，换取零资源创建成本（免费版额度本就充裕）。
  // ⚠️ 由此派生的两条铁律：
  //  1. 本配置**绝不能有 crons**——否则 preview 与生产两个 Worker 每天各扫一次
  //     定投/撮合，同一计划双倍下单、T+1 被提前撮合。
  //  2. preview.yml **不做 D1 迁移**——迁移目标是生产库，PR 的 schema 变更
  //     不允许在评审/合并前碰生产库结构。
  // 刻意不用官方 versions preview URL（wrangler versions upload）？此处无必要：
  // 既然绑定本来就共享，直接独立 Worker 部署即可，URL 还固定稳定。
  "name": "fund-plan-preview",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat：Drizzle / decimal.js 等库需要部分 Node 内建模块垫片
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    // 与生产一致：预览环境注册同名用户同样获得 admin 角色，admin 后台可在预览实测
    "ADMIN_USERNAME": "liujiayii"
  },
  "d1_databases": [
    {
      // 与生产**同一个库**（id 与 wrangler.jsonc 一致）：PR 测试数据直接进生产盘
      "binding": "DB",
      "database_name": "fund-plan-db",
      "database_id": "c38b2d5f-1174-468c-9e23-c6721b860a01",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      // 与生产**同一个 namespace**：缓存互通（预览先拉的档案给生产热身），
      // 代价是 KV 写额度（账户级 1000 次/天）两边共享
      "binding": "KV",
      "id": "3745d67cb9ce41138809df7a9d3a7d1a"
    }
  ],
  // 无 routes：不绑任何自定义域名（生产域名绝不能被预览环境抢走），
  // 仅通过 workers.dev 入口访问。routes 缺省时 workers_dev 默认开启，显式写出防歧义
  "workers_dev": true
  // ⚠️ 刻意没有 triggers.crons，理由见文件头「隔离策略」第 1 条——勿加回
}
