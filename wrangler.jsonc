{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fund-plan",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat：Drizzle / decimal.js 等库需要部分 Node 内建模块垫片
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  },
  // 运行时放置：智能（smart）——wrangler 按 Worker 实际访问的数据自动就近路由，
  // 减少跨区往返。务必写在配置里：Dashboard 手改的 placement 会被下次 `wrangler deploy`
  // 覆盖回默认，只有写进 wrangler.jsonc 才是部署的稳定来源。
  "placement": {
    "mode": "smart"
  },
  "vars": {
    // 管理员用户名：注册时用户名与此一致者获得 admin 角色，其组合公开展示
    "ADMIN_USERNAME": "liujiayii"
    // ⚠️ 不要在这里加 CF Web Analytics 的 token（PR #26 加过、PR #29 撤了）：
    // 线上域名在 CF zone 内走橙云代理，beacon 自动注入默认开启，
    // 页面手动再嵌一份会双上报（pageview 翻倍）。见 app/root.tsx 根 loader 注释。
  },
  "d1_databases": [
    {
      // binding 必须叫 DB —— 代码里全程用 env.DB 访问
      "binding": "DB",
      "database_name": "fund-plan-db",
      "database_id": "c38b2d5f-1174-468c-9e23-c6721b860a01",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "3745d67cb9ce41138809df7a9d3a7d1a"
    }
  ],
  // 线上入口：Custom Domain 绑定 liujiayii.dpdns.org（NS 委派给 CF 的子域 zone）。
  // DNS 记录与 HTTPS 证书全由 CF 托管——原先是「手动 A 记录 + zone route」的组合，
  // 2026-08-31 迁移为 Custom Domain：deploy 幂等保证绑定存在（手滑删了自动恢复），
  // 同 placement 的理由：dashboard 手改的不是稳定来源，wrangler.jsonc 才是。
  // ⚠️ 历史教训：此前用 route pattern 写法时，wrangler 按 PSL 把 zone 推断成
  // dpdns.org（不在本账号），fallback 走 Custom Domain API 撞上既有 A 记录报 100117
  "routes": [
    { "pattern": "liujiayii.dpdns.org", "custom_domain": true },
    // 国内提速「试签」：第二个免费子域 zone，独立分到一对 anycast IP。
    // 主 zone 的 IP 对（104.21.73.133/172.67.145.12）国内绕 AMS 入境
    //（17ce 实测电信 64% 绕欧洲，RTT 中位 431ms）。这对新签若直连美西，
    // 整站对国内即可亚秒级——好签留作国内入口域名，烂签撤掉再走 SaaS 路线。
    // 挂 custom domain 是为了逼出这对 IP（自动建 proxied 记录），见
    // docs/china-access.md「B1 · SaaS 优选 IP → 免费试签」。
    { "pattern": "liujiayi.dpdns.org", "custom_domain": true }
  ],
  // 显式保留 workers.dev 备用入口：routes 一出现 wrangler 默认就关它
  "workers_dev": true,
  "triggers": {
    // Cron 一律用 UTC 书写，注释标注对应北京时间（UTC+8）
    "crons": [
      "0 2 * * *", // 北京 10:00 —— 定投扫描：到期计划生成 pending 申购单
      "30 12 * * *" // 北京 20:30 —— 净值同步 + T+1 撮合确认
    ]
  }
}
